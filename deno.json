{
  "vendor": true,
  "fmt": {
    "include": ["*.js", "tests/*.js", "bin/*.js"]
  },
  "imports": {
    "@std/assert": "https://deno.land/std@0.224.0/assert/assert.ts",
    "@std/http/file-server": "https://deno.land/std@0.224.0/http/file_server.ts",
    "@std/path": "https://deno.land/std@0.224.0/path/mod.ts",
    "@gfx/canvas": "jsr:@gfx/canvas@0.5.6",
    "@astral/astral": "jsr:@astral/astral@0.5.3"
  },
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check *.js tests/*.js bin/*.js",
    "test": "deno test --no-check --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-run --unstable-ffi tests/",
    "parity:gen": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi tests/parity_deno.js",
    "parity:browser": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run tests/parity_browser.js",
    "render": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi render-diagram.js",
    "cli": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi diagram-cli.js",
    "dev": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi dev-server.js",
    "raster-check": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi raster-check.js",
    "upstream-check": "deno run --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi --unstable-ffi bin/upstream-check.js",
    "import:deps": "deno run --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi --unstable-ffi bin/import-depgraph.js",
    "import:tree": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi bin/import-filetree.js"
  }
}
